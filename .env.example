# All variables are server-only. Never use NEXT_PUBLIC_ for credentials.
# preview | doubletick | webhook. Preview skips WhatsApp; email/Sheets still run if set.
RISE_DELIVERY_MODE=preview
DOUBLETICK_API_KEY=
# Registered WhatsApp sender including country code.
DOUBLETICK_FROM=
DOUBLETICK_TEMPLATE_NAME=
DOUBLETICK_TEMPLATE_LANGUAGE=en
# Approved template rise_magazine_delivery on +91 91368 87730.
# Body variable is the first name. Buttons append endings onto https://rise.nmbts.co.in/
DOUBLETICK_TEMPLATE_DATA_JSON={"header":{"type":"IMAGE","mediaUrl":"{{coverUrl}}"},"body":{"placeholders":["{{firstName}}"]},"buttons":[{"type":"URL","parameter":"{{downloadPath}}"},{"type":"URL","parameter":"{{visitPath}}"}]}
RISE_COVER_URL=
RISE_DOWNLOAD_PATH=magazine
RISE_VISIT_PATH=guest
RISE_MAGAZINE_URL=https://rise.nmbts.co.in/magazine
RISE_VISIT_URL=https://rise.nmbts.co.in/visit/guest
# Automation endpoint for full WhatsApp + email delivery, storage and guest requests.
RISE_LEAD_WEBHOOK_URL=
RISE_WEBHOOK_TOKEN=

# --- Email (Gmail SMTP / Nodemailer) — same pattern as JM Visa / BookMyCorp ---
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_RECEIVER=

# --- Google Sheets 1: Form leads (google-apps-script-leads.js) ---
# Sheet: RISE_BNI_Navi_Mumbai_Leads → Extensions → Apps Script → Deploy Web App
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Google Sheets 2: Visitor tracking (google-apps-script-visitor-tracking.js) ---
# Sheet: RISE_BNI_Navi_Mumbai_Visitor_Tracking → Extensions → Apps Script → Deploy Web App
VISITOR_TRACKING_WEBHOOK_URL=
