{
  "name": "magzine-nmbts",
  "version": "1.0.0",
  "description": "RISE magazine — BNI Navi Mumbai reader experience",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --conditions=react-server --test tests/*.test.ts",
    "whatsapp:check": "node --env-file-if-exists=.env.local scripts/check-whatsapp.mjs",
    "whatsapp:test": "node --env-file-if-exists=.env.local --experimental-strip-types --conditions=react-server scripts/send-test-whatsapp.mjs",
    "email:check": "node --env-file-if-exists=.env.local scripts/check-email.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "private": true
}
